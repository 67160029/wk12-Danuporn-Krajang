PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=student_db

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=1h

