{
  "name": "student-api",
  "version": "1.0.0",
  "description": "Student API - Week 12 (Advanced Validation + Rate Limiter)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand",
    "seed:admin": "node scripts/create-admin.js",
    "test:api": "newman run postman_collection.json -e environment.json",
    "test:api:html": "newman run postman_collection.json -e environment.json -r htmlextra --reporter-htmlextra-export newman/report.html",
    "test:failure": "node scripts/failure-scenarios.js",
    "test:ratelimit": "newman run postman_ratelimit.json -e environment.json -n 20 --delay-request 0"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "redis",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.14.3",
    "redis": "^5.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
